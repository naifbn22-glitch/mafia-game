PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,https://YOUR-PROJECT.vercel.app,https://localhost
REDIS_URL=redis://default:PASSWORD@HOST:PORT
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
VITE_SERVER_URL=http://localhost:3000

# Set true to announce one AI voice comment after each completed night.
# Use demo mode locally to test the room sync and device speech without API costs.
AI_COMMENTARY_ENABLED=false
AI_COMMENTARY_MODE=demo
OPENAI_API_KEY=
AI_COMMENTARY_TEXT_MODEL=gpt-4.1-mini
AI_COMMENTARY_SPEECH_MODEL=gpt-4o-mini-tts
AI_COMMENTARY_VOICE=marin

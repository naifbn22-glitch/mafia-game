{
  "name": "mafia-game",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.js",
    "dev:server": "node --watch server.js",
    "cap:sync": "npm run build && npx cap sync",
    "cap:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "cap:add:ios": "npx cap add ios",
    "cap:android": "npm run build && npx cap sync android && npx cap open android",
    "cap:add:android": "npx cap add android"
  },
  "devDependencies": {
    "@capacitor/android": "^5.7.8",
    "@capacitor/cli": "^5.7.8",
    "@capacitor/ios": "^5.7.8",
    "glob": "^10.3.10",
    "vite": "^4.5.14",
    "vite-plugin-pwa": "^0.16.7",
    "workbox-build": "^6.6.0",
    "workbox-window": "^6.6.0"
  },
  "dependencies": {
    "@capacitor/app": "^5.0.8",
    "@capacitor/core": "^5.7.8",
    "@capacitor/haptics": "^5.0.8",
    "@capacitor/status-bar": "^5.0.8",
    "@socket.io/redis-adapter": "^8.3.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "path-scurry": "^1.10.2",
    "pg": "^8.16.3",
    "redis": "^5.8.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  }
}
